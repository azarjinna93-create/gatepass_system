# Copy to .env.aws on the EC2 host (never commit real secrets).

# Postgres password for the Docker DB on this EC2
# Use letters/numbers only (avoid @ # : / — they break the DB URL)
POSTGRES_PASSWORD=AcaciaDbPass123

# Full DB URL used by the API (password must match POSTGRES_PASSWORD)
DATABASE_URL=postgresql://gatepass:AcaciaDbPass123@db:5432/gatepass
PGSSL=false

# Long random string for login tokens
JWT_SECRET=AcaciaJwtSecret12345678

# Public URLs (use your EC2 public IP)
NEXT_PUBLIC_APP_URL=http://13.60.96.50
NEXT_PUBLIC_API_URL=http://13.60.96.50:4000
CORS_ORIGIN=http://13.60.96.50
