# Copy to .env.aws on the EC2 host (never commit real secrets).

# Postgres password for the Docker DB on this EC2 (pick a strong one)
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Long random string for login tokens
JWT_SECRET=change-me

# Public URLs (use your EC2 public IP)
# Example:
#   NEXT_PUBLIC_APP_URL=http://13.60.96.50
#   NEXT_PUBLIC_API_URL=http://13.60.96.50:4000
#   CORS_ORIGIN=http://13.60.96.50
NEXT_PUBLIC_APP_URL=http://YOUR_EC2_PUBLIC_IP
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:4000
CORS_ORIGIN=http://YOUR_EC2_PUBLIC_IP
